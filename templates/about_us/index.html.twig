{% extends 'base.html.twig' %}
{% block index %}<meta name="robots" content="index, follow">{% endblock %}

{% block title %}О нашем питомнике Мейн Кунов | Забота и любовь к кошкам{% endblock %}
{% block desc %}Мы - любители мейн-кунов! Узнайте о нашем питомнике, философии разведения и том, как мы заботимся о своих пушистых друзьях.{% endblock %}
{% block keywords %}питомник мейн кун, о нас, забота о кошках{% endblock %}
{% block canonical_url %}
<link rel="canonical" href="{{ path('app_about_us') }}" />
{% endblock %}
{% block og_title %}О нас - Grande Linci LV{% endblock %}
{% block og_description %}Узнайте больше о Grande Linci LV: кто мы, наша история и философия разведения мейн-кунов.{% endblock %}
{% block body %}
<div class="container-fluid d-flex flex-column align-items-center justify-content-between home-preview position-fixed z-0">
</div>
<div class="container-fluid d-flex align-items-top justify-content-start preview-content position-fixed z-1">
    <div class="col-6 d-flex justify-content-center align-items-center">
        <img class="image-container col-9" src="{{ asset('img/about-us.webp')}}" alt="cat">
    </div>
   
    <div class="logo-group blured d-flex col-6 flex-column align-items-center justify-content-center">
            <h1>{{ 'About us'|trans }}</h1>
        <nav aria-label="breadcrumb">
        <ol itemscope itemtype="http://schema.org/BreadcrumbList" class="breadcrumb">
            <li itemprop="itemListElement" itemscope
                itemtype="http://schema.org/ListItem"
                class="breadcrumb-item">
                <a itemprop="item" href="{{ path('app_home') }}">
                    <span itemprop="name">{{ 'Main'|trans }}</span></a>
                <meta itemprop="position" content="1" />
            </li>
            <li itemprop="itemListElement" itemscope
                itemtype="http://schema.org/ListItem"
                class="breadcrumb-item active">
                <a itemprop="item" href="{{ path('app_about_us') }}">
                    <span itemprop="name">{{ 'About us'|trans }}</span></a>
                <meta itemprop="position" content="2" />
            </li>
        </ol>
        </nav>

            <div class="arrow-group d-flex justify-content-between align-items-center">
            <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
            <div class="arrow-body"></div>
            <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
            </div>
        </div>
    
</div>

<div class="container-fluid position-absolute z-2 main-content">

<div class="section section-green container-fluid">
    <div class="container d-flex justify-content-center align-items-center">
        <div class="title d-flex flex-column align-items-center justify-content-center">
            <h2 class="ungapped">{{ 'History of Grande linci'|trans }}</h2>
            <img src="{{ asset('img/arrow/simple-arrow.png') }}" alt="arrow">
            
            <p class="subtext">{{ 'About us page text'|trans }}</p>
        </div>
    </div>
</div>

<div class="section section-white container-fluid">
    <div class="container">
        <div class="section-inner d-flex about-us">
            <div class="side-image image-container shaded-grey"><img src="{{ asset('img/default.png') }}" alt="cat"></div>
            <div class="aside-advantages d-flex flex-column align-items-start">
                <div class="title">
                    <h2>{{ 'our advantages'|trans }}</h2>
                </div>

                <div class="advantage-item d-flex flex-column">
                    <h3>{{ 'Full Health'|trans }}</h3>
                    <p>{{ 'advanage 1'|trans }}</p>
                    <div class="image-container"><img src="{{ asset('img/arrow/dark-arrow.png') }}" alt="dark-arrow"></div>
                </div>

                <div class="advantage-item d-flex flex-column">
                    <h3>{{ 'Worldwide'|trans }}</h3>
                    <p>{{ 'advantage 2'|trans }}</p>
                    <div class="image-container"><img src="{{ asset('img/arrow/dark-arrow.png') }}" alt="dark-arrow"></div>
                </div>

                <div class="advantage-item d-flex flex-column">
                    <h3>{{ 'Socialization'|trans }}</h3>
                    <p>{{ 'advantage 3'|trans }}</p>
                    <div class="image-container"><img src="{{ asset('img/arrow/dark-arrow.png') }}" alt="dark-arrow"></div>
                </div>

                <div class="advantage-item d-flex flex-column">
                    <h3>{{ 'Care Package'|trans }}</h3>
                    <p>{{ 'advantage 4'|trans }}</p>
                    <div class="image-container"><img src="{{ asset('img/arrow/dark-arrow.png') }}" alt="dark-arrow"></div>
                </div>
            </div>  
        </div>
    </div>
</div>

{% include 'footer.html.twig' %}
</div>
{% endblock %}
