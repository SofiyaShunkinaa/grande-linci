{% extends 'base.html.twig' %}
{% block index %}<meta name="robots" content="index, follow">{% endblock %}

{% block title %}Котята Мейн Кунов - Доступные питомцы | Найдите своего друга{% endblock %}
{% block desc %}Посмотрите на наших замечательных котят мейн кунов! Ищете пушистого друга? Узнайте о доступных малышах и их характеристиках.{% endblock %}
{% block keywords %}котята мейн кун, купить котенка, питомцы{% endblock %}
{% block canonical_url %}
<link rel="canonical" href="{{ path('app_available_kittens', {id: 'default', keyWord: 'main-coons'}) }}" />
{% endblock %}
{% block microdata %}
<!-- JSON-LD Generated by: https://hallanalysis.com/json-ld-generator/ -->
<script type='application/ld+json'> 
{
  "@context": "http://www.schema.org",
  "@type": "AnimalShelter",
  "name": "Grande Linci",
  "url": "https://grande-linci.onrender.com/about-breed/main-coon",
  "description": "Maine coon and oriental cattery",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Riga",
    "addressCountry": "Latvia"
  },
  "openingHours": "Mo, Tu, We, Th, Fr, Sa, Su -",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+371(25)614-622"
  }
}
 </script>
{% endblock %}
{% block og_title %}Котята мейн-кун в Grande Linci LV{% endblock %}
{% block og_description %}Ищете мейн-куна? Посмотрите на наших котят, доступных для резервирования.{% endblock %}
{% block body %}
<div class="container-fluid d-flex flex-column align-items-center justify-content-between home-preview position-fixed z-0">
</div>
<div class="container-fluid d-flex align-items-top justify-content-start preview-content position-fixed z-1">
    <div class="col-6 d-flex justify-content-center align-items-end">
        <img class="image-container col-9" src="{{ asset('img/our-cats.png')}}" alt="cat">
    </div>
   
    <div class="logo-group blured d-flex col-6 flex-column align-items-center justify-content-center">
            <h1>{{ 'Available kittens'|trans }}</h1>
        <nav aria-label="breadcrumb">
        <ol itemscope itemtype="http://schema.org/BreadcrumbList" class="breadcrumb">
            <li itemprop="itemListElement" itemscope
                itemtype="http://schema.org/ListItem"
                class="breadcrumb-item">
                <a itemprop="item" href="{{ path('app_home') }}">
                    <span itemprop="name">{{ 'Main'|trans }}</span></a>
                <meta itemprop="position" content="1" />
            </li>
            <li itemprop="itemListElement" itemscope
                itemtype="http://schema.org/ListItem"
                class="breadcrumb-item active">
                <a itemprop="item" href="{{ path('app_available_kittens', {id: 'default', keyWord: 'main-coons'}) }}">
                    <span itemprop="name">{{ 'Available kittens'|trans }}</span></a>
                <meta itemprop="position" content="2" />
            </li>
        </ol>
        </nav>

            <div class="arrow-group d-flex justify-content-between align-items-center">
                <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
                <div class="arrow-body"></div>
                <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
            </div>
            <h2 class="text-capitalize text-white">{{ 'Main Coons'|trans }}</h2>
        </div>
</div>

<div class="container-fluid position-absolute z-2 main-content">
    <div class="section section-white container-fluid">
        <div class="container">
            <div class="title">
                <h2>{{ 'Choose litter'|trans }}</h2>
            </div>

             <div class="swiper swiper-kittens container slider-container">
                <div class="swiper-wrapper ">
                    {% for button in buttons %}
                        <div class="swiper-slide image-container">
                            <button class="btn litter-button d-flex flex-column justify-content-center align-items-center {% if button.status %}available{% else %}not-available{% endif %}"
                                    data-id="{{ button.id }}"
                                    data-breed="{{ keyWord }}">
                                <span>{{button.name}}</span>
                                <p>{% if button.status is same as(true) %}{{ 'Available kittens'|trans }}{% else %}{{ 'All kittens adopted'|trans}}{% endif %}</p>
                            </button>
                        </div>
                    {% endfor %}
      
                </div>

                <div class="swiper-pagination"></div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>    
            </div>

        </div>
    </div>

    <div class="section section-green container-fluid">
        <div class="container d-flex flex-column align-items-center justify-content-center" id="litter-block">
            {% if litter is not null %}
                <div class="title d-flex flex-column align-items-center justify-content-center">
                    <h2>{{ 'LITTER'|trans }} {{ litter.name }}</h2>
                    <img src="{{ asset('img/arrow/simple-arrow.png') }}" alt="arrow">
                    <p>{{ litter.date | date('d.m.Y') }}</p>
                </div>

                <div class="section-inner d-flex justify-content-center align-items-start litter__parents">
                    <div class="col-3 cat-parent d-flex flex-column align-items-center">
                        <div class="image-container shaded-green">
                            <img src="{{ asset('img/cats/' ~ mother.imageLink )}}" alt="Cat mother">
                        </div>
                        <h4>{{ mother.name }}</h4>
                    </div>

                    <div class="parent-divider">
                        <img src="{{ asset('img/arrow/litter-divider-lg.png') }}" alt="arrow">
                    </div>

                    <div class="col-3 cat-parent d-flex flex-column align-items-center">
                        <div class="image-container shaded-green">
                            <img src="{{ asset('img/cats/' ~ father.imageLink )}}" alt="Cat father">
                        </div>
                        <h4>{{ father.name }}</h4>
                    </div>
                </div>

                <div class="section-white container section d-flex flex-wrap section-kittens justify-content-center">
                    {% for kitten in kittens %}
                        <div class="col-3 d-flex flex-column align-items-center">
                            <div class="image-container">
                                <img src="{{ asset('img/kittens/' ~ kitten.imageLink )}}" alt="kitten">
                            </div>
                            <h4>{{ kitten.name }}</h4>
                            <h5>{{ kitten.price }}€</h5>
                            <button class="kitten-status book-kitten-button
            {% if kitten.kittenStatus == 'At home' %}status-home disabled btn{% endif %}
            {% if kitten.kittenStatus == 'Reserved' %}status-reserved disabled btn{% endif %}
            {% if kitten.kittenStatus == 'Available' %}status-available{% endif %}"
                                    data-bs-toggle="modal"
                                    data-bs-target="#bookingModal{{ kitten.id }}"
                                    data-kitten-id="{{ kitten.id }}">
                                <span>{{ kitten.kittenStatus|trans }}</span>
                            </button>

                            <!-- Проверяем, авторизован ли пользователь -->
                            {% if not app.user %}
                                <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="bookingModalLabel">{{ 'Уведомление'|trans}}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-center">
                                                <p>{{ 'Для бронирования необходимо'|trans}} <a href="{{ path('app_register') }}">{{ 'зарегистрироваться'|trans}}</a> {{ 'или'|trans}} <a href="{{ path('app_login') }}">{{ 'войти'|trans}}</a>.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% elseif kitten.kittenStatus == 'Available' %}
                                {% set existingBooking = bookings|filter(booking => booking.kitten.id == kitten.id and booking.user.id == app.user.id) %}

                                {% if existingBooking|length > 0 %}
                                    <!-- Попап о наличии активной заявки -->
                                    <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="bookingModalLabel">{{ 'Уведомление'|trans }}</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-center">
                                                    <p>{{ 'Вы уже оставили заявку на этого котенка.'|trans }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <!-- Модальное окно бронирования -->
                                    <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="bookingModalLabel">{{ 'Забронировать'|trans }} {{ kitten.name }}</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    {{ form_start(form, { 'action': path('kitten_book', { 'id': kitten.id }), 'method': 'POST' }) }}

                                                    <input type="hidden" name="kitten_id" id="kitten_id_{{ kitten.id }}" value="{{ kitten.id }}">

                                                    <div class="d-flex justify-content-between">
                                                        <button type="submit" class="btn btn-primary">{{ 'Забронировать'|trans }}</button>
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Отмена'|trans }}</button>
                                                    </div>

                                                    {{ form_end(form) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    {% endfor %}

                </div>

            {% else %}
                <h2>No active litter available!</h2>
            {% endif %}


        </div>
</div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.litter-button').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const litterId = this.dataset.id;
                    const breed = this.dataset.breed;

                    // Меняем URL
                    const newUrl = `/available-kittens/${breed}/${litterId}`;
                    window.location.href = newUrl; // обычная загрузка страницы
                });
            });
        });
    </script>

    {% include 'footer.html.twig' %}

{% endblock %}
