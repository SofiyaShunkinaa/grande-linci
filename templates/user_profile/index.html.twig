{% extends 'base.html.twig' %}

{% block title %}{{ 'Редактировать профиль'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'Редактировать профиль'|trans }}</h1>
        <div class="dashboard">
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">{{ 'Редактировать данные'|trans }}</h5>
                            {{ form_start(form) }}
                            {{ form_row(form.username) }}
                            {{ form_row(form.firstName) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.phone) }}
                            <button type="submit" class="btn btn-primary">{{ 'Сохранить'|trans }}</button>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
