{% extends 'base.html.twig' %}
{% block index %}<meta name="robots" content="index, follow">{% endblock %}

{% block title %}Котята Мейн Кунов - Питомник Кошек | Друзья и Компаньоны{% endblock %}
{% block desc %}Добро пожаловать в наш питомник мейн-кунов! Здесь вы найдете информацию о породе, наших кошках и котятах, а также полезные советы по уходу.{% endblock %}
{% block keywords %}мейн кун, питомник, котята{% endblock %}
{% block microdata %}
    <!-- Разметка JSON-LD, созданная Мастером разметки структурированных данных Google. -->
    <script type="application/ld+json">
        {
            "@context": "http://schema.org",
            "@type": "LocalBusiness",
            "name": "Grande Linci LV",
            "telephone": "+371(25)614-622",
            "email": "karoleinga@gmail.com"
        }
    </script>
{% endblock %}
{% block og_title %}Добро пожаловать на Grande Linci LV{% endblock %}
{% block og_description %}Питомник Grande Linci LV - это роскошные мейн-куны, заботливое разведение и профессиональный уход.{% endblock %}
{% block body %}
    <div class="container-fluid d-flex flex-column align-items-center justify-content-between home-preview position-fixed z-0">
    </div>
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    <div class="container-fluid d-flex flex-column align-items-center justify-content-between preview-content position-fixed z-1">
        <div class="logo-group container d-flex flex-column align-items-center justify-content-center">
            <h1>GRANDE LINCI* LV</h1>
            <div class="arrow-group d-flex justify-content-between align-items-center">
                <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
                <div class="arrow-body"></div>
                <div class="arrow-end"><img src="{{ asset('img/arrow/ending.svg') }}" alt="arrow end"></div>
            </div>
            <p class="sublogo">{{ "Maine Coon and Oriental Cattery"|trans }}</p>
        </div>

        <div class="down-link d-flex flex-column align-items-center justify-content-center">
            <p><a href="#litter-section" class="text-decoration-none text-white">{{ "Choose a kitten"|trans }}</a></p>
            <img src="{{ asset('img/arrow/down.png') }}" alt="down arrow">
        </div>

        <div class="position-absolute cat-preview image-container left"><img src="{{ asset('img/cat-father.webp') }}" alt="cat"></div>
        <div class="position-absolute cat-preview image-container right"><img src="{{ asset('img/cat-mother.webp') }}" alt="cat"></div>
    </div>

    <div class="container-fluid position-absolute z-2 main-content">
        <div class=" section-green section">
            <div class="container d-flex flex-column align-items-center justify-content-center">
                <div class="title d-flex flex-column align-items-center justify-content-center">
                    <h2 class="ungapped">{{ "Welcome"|trans}}</h2>
                    <img src="{{ asset('img/arrow/simple-arrow.png') }}" class="arrow-divider--green" alt="arrow">
                    <p class="col-sm-12 col-md-8">
                        {{ 'Welcome-text'|trans}}
                    </p>
                </div>

                <div class="swiper swiper-home container slider-container">
                    <div class="swiper-wrapper ">
                        <div class="swiper-slide image-container"><img src="{{ asset('img/slider/1.webp') }}" alt="slider slide"></div>
                        <div class="swiper-slide image-container"><img src="{{ asset('img/slider/2.webp') }}" alt="slider slide"></div>
                        <div class="swiper-slide image-container"><img src="{{ asset('img/slider/3.webp') }}" alt="slider slide"></div>
                        <div class="swiper-slide image-container"><img src="{{ asset('img/slider/4.webp') }}" alt="slider slide"></div>
                        <div class="swiper-slide image-container"><img src="{{ asset('img/slider/5.webp') }}" alt="slider slide"></div>
                    </div>

                    <div class="swiper-pagination"></div>
                </div>
            </div>
        </div>
        <div class="section section-white container-fluid">
            <div class="container">


                <div class="section-inner d-flex about-us home">
                    <div class="side-image image-container shaded-grey col-md-3"><img src="{{ asset('img/cats/CAT1.png') }}" alt="cat"></div>
                    <div class="aside-text d-flex flex-column align-items-start">
                        <div class="title">
                            <h2>{{ "About us"|trans }}</h2>
                        </div>
                        <p>
                            {{ 'About us text'|trans }}
                        </p>
                        <div class="image-container">
                            <img src="{{ asset('img/arrow/dark-arrow.png') }}" alt="arrow">
                        </div>
                        <button class="btn"><a href="{{ path('app_about_us') }}" >{{ "Learn more"|trans}}</a></button>
                    </div>
                </div>
            </div>
        </div>


        <div class="section section-green container-fluid litter" id="litter-section">
            <div class="container d-flex flex-column align-items-center justify-content-center">
                {% if litter is not null %}
                    <div class="title d-flex flex-column align-items-center justify-content-center">
                        <h2>{{ 'LITTER'|trans}} {{ litter.name }}</h2>
                        <img src="{{ asset('img/arrow/simple-arrow.png') }}" alt="arrow">
                        <p>{{ litter.date | date('d.m.Y') }}</p>
                    </div>

                    <div class="section-inner d-flex justify-content-center align-items-start litter__parents">
                        <div class="col-3 cat-parent d-flex flex-column align-items-center">
                            <div class="image-container shaded-green">
                                <img src="{{ asset('img/cats/' ~ mother.imageLink )}}" alt="Cat mother">
                            </div>
                            <h4>{{ mother.name }}</h4>
                        </div>

                        <div class="parent-divider">
                            <img src="{{ asset('img/arrow/litter-divider-lg.png') }}" alt="arrow">
                        </div>

                        <div class="col-3 cat-parent d-flex flex-column align-items-center">
                            <div class="image-container shaded-green">
                                <img src="{{ asset('img/cats/' ~ father.imageLink )}}" alt="Cat father">
                            </div>
                            <h4>{{ father.name }}</h4>
                        </div>
                    </div>

                    <div class="section-white container section d-flex flex-wrap section-kittens justify-content-center">
                        {% for kitten in kittens %}
                            <div class="col-3 d-flex flex-column align-items-center">
                                <div class="image-container">
                                    <img src="{{ asset('img/kittens/' ~ kitten.imageLink )}}" alt="kitten">
                                </div>
                                <h4>{{ kitten.name }}</h4>
                                <h5>{{ kitten.price }}€</h5>
                                <button class="kitten-status book-kitten-button
            {% if kitten.kittenStatus == 'At home' %}status-home disabled btn{% endif %}
            {% if kitten.kittenStatus == 'Reserved' %}status-reserved disabled btn{% endif %}
            {% if kitten.kittenStatus == 'Available' %}status-available{% endif %}"
                                        data-bs-toggle="modal"
                                        data-bs-target="#bookingModal{{ kitten.id }}"
                                        data-kitten-id="{{ kitten.id }}">
                                    <span>{{ kitten.kittenStatus|trans }}</span>
                                </button>

                                <!-- Проверяем, авторизован ли пользователь -->
                                {% if not app.user %}
                                    <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="bookingModalLabel">{{ 'Уведомление'|trans }}</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-center">
                                                    <p>{{ 'Для бронирования необходимо'|trans }} <a href="{{ path('app_register') }}">{{ 'зарегистрироваться'|trans}}</a> {{ 'или'|trans}} <a href="{{ path('app_login') }}">{{ 'войти'|trans}}</a>.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% elseif kitten.kittenStatus == 'Available' %}
                                    {% set existingBooking = bookings|filter(booking => booking.kitten.id == kitten.id and booking.user.id == app.user.id) %}

                                    {% if existingBooking|length > 0 %}
                                        <!-- Попап о наличии активной заявки -->
                                        <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="bookingModalLabel">{{ 'Уведомление'|trans}}</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-center">
                                                        <p>{{ 'Вы уже оставили заявку на этого котенка'|trans}}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <!-- Модальное окно бронирования -->
                                        <div class="modal fade" id="bookingModal{{ kitten.id }}" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="bookingModalLabel">{{ 'Забронировать'|trans}} {{ kitten.name }}</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        {{ form_start(formBooking, { 'action': path('kitten_book', { 'id': kitten.id }), 'method': 'POST' }) }}

                                                        <input type="hidden" name="kitten_id" id="kitten_id_{{ kitten.id }}" value="{{ kitten.id }}">

                                                        <div class="d-flex justify-content-between">
                                                            <button type="submit" class="btn btn-primary">{{ 'Забронировать'|trans}}</button>
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Отмена'|trans}}</button>
                                                        </div>

                                                        {{ form_end(formBooking) }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endfor %}

                    </div>

                {% else %}
                    <h2>No active litter available!</h2>
                {% endif %}
            </div>
        </div>


        {% include 'forms/contact_form.html.twig' %}
        {% include 'footer.html.twig' %}
    </div>
{% endblock %}
